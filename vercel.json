{
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install && cd frontend && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/files/:file*",
      "destination": "/api/files/proxy"
    },
    {
      "source": "/api/music/:id",
      "destination": "/api/music/detail"
    },
    {
      "source": "/api/photos/:id",
      "destination": "/api/photos/detail"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "regions": ["hnd1"]
    }
  }
}
